# ═══════════════════════════════════════════════════════════
#  HeyMate — Environment Variables Template
#  Copy this file to .env and fill in your values:
#    cp .env.template .env
# ═══════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────
# Port the Express server listens on (Railway sets this automatically)
PORT=3000

# Node environment: development | staging | production
NODE_ENV=production

# ── URLs ──────────────────────────────────────────────────
# Public-facing frontend URL (Railway provides this after first deploy)
FRONTEND_URL=https://heymateapp-production.up.railway.app

# Backend API URL
BACKEND_URL=https://heymatebackend-production.up.railway.app

# ── Database (PostgreSQL) ─────────────────────────────────
# Railway auto-injects DATABASE_URL when you add a Postgres plugin
DATABASE_URL=postgresql://user:password@host:5432/heymate

# ── Authentication / Secrets ──────────────────────────────
# JWT secret for signing tokens
JWT_SECRET=change-me-to-a-random-string

# Session secret
SESSION_SECRET=change-me-to-a-random-string

# ── Third-Party Services ──────────────────────────────────
# Push notifications (Expo)
EXPO_ACCESS_TOKEN=

# Payment gateway
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Maps / Geocoding
GOOGLE_MAPS_API_KEY=

# ── Railway ───────────────────────────────────────────────
# Railway API token (used by CLI & CI/CD)
RAILWAY_TOKEN=

# Railway project ID (find in project settings)
RAILWAY_PROJECT_ID=

# Railway service ID (find in service settings)
RAILWAY_SERVICE_ID=
